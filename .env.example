# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster> with your MongoDB Atlas details:
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vehicle_manager?retryWrites=true&w=majority"

# Vercel Blob Token (Required for cloud photo uploads on Vercel)
# Automatically injected when you add Vercel Blob in your Vercel project settings:
BLOB_READ_WRITE_TOKEN=""
